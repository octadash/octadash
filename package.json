{
  "name": "octadash",
  "private": true,
  "description": "Open source monitoring for people who run many products: uptime, analytics, errors, revenue, AI cost and logs in one place.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:migrate": "pnpm --filter @octadash/worker migrate",
    "db:up": "docker compose -f docker-compose.dev.yml up -d"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "turbo": "2.11.13",
    "typescript": "~6.0.3"
  }
}
