<!-- Octadash defaults for the bundled ClickHouse: fits a 4 GB VPS next to
     Postgres, Valkey and the Octadash roles, and keeps ClickHouse's own
     logging tables from filling the disk. Mounted into config.d. -->
<clickhouse>
    <logger>
        <level>warning</level>
        <console>1</console>
    </logger>
    <!-- At most 40% of the machine's memory for ClickHouse. -->
    <max_server_memory_usage_to_ram_ratio>0.4</max_server_memory_usage_to_ram_ratio>
    <mark_cache_size>268435456</mark_cache_size>
    <index_mark_cache_size>67108864</index_mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>
    <!-- BACKUP ... TO File('name.zip') writes to /var/lib/clickhouse/backups. -->
    <backups>
        <allowed_path>backups/</allowed_path>
    </backups>
    <!-- Internal introspection tables. Octadash does not read them. -->
    <query_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <query_metric_log remove="1"/>
    <part_log remove="1"/>
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <processors_profile_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <session_log remove="1"/>
    <error_log remove="1"/>
    <latency_log remove="1"/>
    <blob_storage_log remove="1"/>
    <backup_log remove="1"/>
    <s3queue_log remove="1"/>
    <asynchronous_insert_log remove="1"/>
    <background_schedule_pool_log remove="1"/>
</clickhouse>
