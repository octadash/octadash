# Copy to .env and fill in. Used by docker-compose.yml.

# Image tag. "edge" follows the main branch until the first release.
OCTADASH_VERSION=edge

# Passwords for the bundled Postgres, ClickHouse and Valkey, and the secret.
# ./scripts/generate-env.sh fills the empty ones for you. Hex values only for
# the three passwords: they go inside connection URLs.
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
VALKEY_PASSWORD=

# Signs sessions and encrypts integration credentials.
OCTADASH_SECRET=

# Public URLs. The panel and the ingest service each get their own address.
OCTADASH_URL=http://localhost:3000
OCTADASH_INGEST_URL=http://localhost:4000

LOG_LEVEL=info

# Let anyone create an account. Off by default: the first visitor becomes the
# owner and everyone else joins by invitation.
# OCTADASH_OPEN_SIGNUP=false

# Local development only (services from docker-compose.dev.yml):
# DATABASE_URL=postgres://octadash:octadash@localhost:5432/octadash
# CLICKHOUSE_URL=http://octadash:octadash@localhost:8123/octadash
# VALKEY_URL=redis://:octadash@localhost:6379
